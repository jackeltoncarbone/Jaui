/* Playground stylesheet — proves end-to-end that JSS parses, the Vite
   plugin transforms, and the runtime Jiv constructor accepts the result. */

DemoCard {
  Background: rgb(44, 52, 72)
  BorderRadius: 24
  BorderColor: rgba(255, 255, 255, 0.15)
  BorderWidth: 1
  Padding: 18 22
  ShadowColor: rgba(0, 0, 0, 0.35)
  ShadowBlur: 20
  ShadowOffsetY: 8
}

DemoCardTitle {
  FontSize: 18
  FontWeight: 700
  Color: rgba(255, 255, 255, 0.95)
}
