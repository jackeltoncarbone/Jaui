{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "types": ["@webgpu/types"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "jaui": ["../Jaui/src/Core/Jaui.ts"],
      "@jaui/*": ["../Jaui/src/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "../Jaui/src/Jss/Jss.d.ts",
    "../Jaui/src/glsl.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
