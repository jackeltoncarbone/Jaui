{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "types": ["@webgpu/types", "node"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "Source",
    "baseUrl": ".",
    "paths": {
      "@jaui/*": ["Source/*"]
    }
  },
  "include": ["Source/**/*.ts", "Source/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "playground", "tests"]
}
